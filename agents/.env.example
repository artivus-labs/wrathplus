# Keys for the agents: bring your own. Nothing of ours is needed, and both lines below may stay
# empty. Copy to agents/.env (git-ignored, keep it 0600) in the main checkout. The shell wins over
# this file.

# The planner (required tier) is Claude. By default it runs on this machine's own Claude Code
# login (sign in once with `claude`; a Claude subscription works) and ignores ANTHROPIC_API_KEY
# from the shell. To bill your own Anthropic API key instead, set it here.
WRATHPLUS_ANTHROPIC_API_KEY=

# Optional: TypeSafe's Jev, the fast decision tier (your own key from https://typesafe.ai).
# Without it the fast tier is off and the agent runs on the planner, the client's built-in Lua
# and the goal runner.
TYPESAFE_API_KEY=
