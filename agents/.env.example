# Keys for the agents: copy to agents/.env (git-ignored) in the main checkout. The shell wins
# over this file.

# TypeSafe's Jev, the fast decision tier (https://typesafe.ai). Without it the fast tier is off.
TYPESAFE_API_KEY=

# The planner runs on this machine's Claude Code login (a Claude subscription) by default, and
# ignores ANTHROPIC_API_KEY from the shell. To bill an API key instead, set it here.
WRATHPLUS_ANTHROPIC_API_KEY=
