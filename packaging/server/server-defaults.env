# Server settings when Compose is used without the Manager: the Manager's Playerbots defaults
# (crates/wrathplus-manager/src/server/module_settings.rs; a Manager test keeps them equal).
# AzerothCore reads AC_ + a config key in upper snake case as an override of that key.
AC_PLAYERBOTS_ADD_CLASS_ACCOUNT_POOL_SIZE='50'
AC_PLAYERBOTS_DOWNGRADE_MAX_LEVEL_BOT='1'
AC_PLAYERBOTS_ENABLE_PERIODIC_ONLINE_OFFLINE='0'
AC_PLAYERBOTS_MAX_RANDOM_BOTS='2000'
AC_PLAYERBOTS_MAX_RANDOM_BOT_RANDOMIZE_TIME='172800'
AC_PLAYERBOTS_MIN_RANDOM_BOTS='1000'
AC_PLAYERBOTS_MIN_RANDOM_BOT_RANDOMIZE_TIME='7200'
AC_PLAYERBOTS_PERIODIC_ONLINE_OFFLINE_RATIO='2.0'
AC_PLAYERBOTS_RANDOM_BOT_AUTOLOGIN='1'
AC_PLAYERBOTS_RANDOM_BOT_GUILD_COUNT='20'
AC_PLAYERBOTS_RANDOM_BOT_MAX_LEVEL='80'
AC_PLAYERBOTS_RANDOM_BOT_MIN_LEVEL='1'
