# Beta server settings: the Manager's Playerbots defaults (packaging/server/server-defaults.env)
# with the online random-bot population pinned to what the box holds (README: Bot count), and
# mod-playerbots' canned chat off in favour of mod-llm-chatter.
# AzerothCore reads AC_ + a config key in upper snake case as an override of that key.
AC_PLAYERBOTS_ADD_CLASS_ACCOUNT_POOL_SIZE='50'
AC_PLAYERBOTS_DOWNGRADE_MAX_LEVEL_BOT='1'
AC_PLAYERBOTS_ENABLE_PERIODIC_ONLINE_OFFLINE='0'
AC_PLAYERBOTS_MAX_RANDOM_BOTS='400'
AC_PLAYERBOTS_MAX_RANDOM_BOT_RANDOMIZE_TIME='172800'
AC_PLAYERBOTS_MIN_RANDOM_BOTS='400'
AC_PLAYERBOTS_MIN_RANDOM_BOT_RANDOMIZE_TIME='7200'
AC_PLAYERBOTS_PERIODIC_ONLINE_OFFLINE_RATIO='2.0'
AC_PLAYERBOTS_RANDOM_BOT_AUTOLOGIN='1'
AC_PLAYERBOTS_RANDOM_BOT_GUILD_COUNT='20'
AC_PLAYERBOTS_RANDOM_BOT_MAX_LEVEL='80'
AC_PLAYERBOTS_RANDOM_BOT_MIN_LEVEL='1'
# Agents walk by navmesh paths; the core's over-speed ping check kicked them (and laggy players).
AC_MAX_OVERSPEED_PINGS='0'
# mod-llm-chatter replaces mod-playerbots' own canned bot chat (its README, "Disable Default Bot
# Chat"): random talk, dungeon suggestions and broadcasts off. Greet, emote and say-without-master
# are already off upstream.
AC_PLAYERBOTS_RANDOM_BOT_TALK='0'
AC_PLAYERBOTS_RANDOM_BOT_SUGGEST_DUNGEONS='0'
AC_PLAYERBOTS_ENABLE_BROADCASTS='0'
