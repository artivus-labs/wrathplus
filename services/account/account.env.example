# WrathPlus account service. Copy to /etc/wrathplus/account.env (0600). No secrets go here.
PUBLIC_URL=https://wrathplus.artivus.com.au
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
# SQLite state and the OAuth signing keys (created 0600 on first start). Back it up.
ACCOUNT_DATA_DIR=/var/lib/wrathplus-account
# The worldserver's SOAP port, loopback only, and a 0600 file holding USER:PASSWORD of a
# gmlevel-3 account used only for SOAP.
SOAP_URL=http://127.0.0.1:17878/
SOAP_CREDENTIALS_FILE=/etc/wrathplus/soap-account
REALM_ADDRESS=wrathplus.artivus.com.au:3724
REALM_NAME=wrathplus.artivus.com.au
EVENT_POLL_MS=5000
PUBLISH_QUESTS=0
# RESERVED_ACCOUNT_PREFIXES=RNDBOT,AHBOT,WPMANAGER,ADMIN,SOAP
# HOSTED_HANDLE_SUFFIXES=bsky.social
# LOGINS_PER_IP=20
# LOGINS_PER_IP_WINDOW_S=600
# ISSUES_PER_DID=10
# ISSUES_PER_DID_WINDOW_S=3600
