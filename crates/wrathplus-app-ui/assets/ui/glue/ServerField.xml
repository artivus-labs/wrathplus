<!--
	AzerothBench's own addition to the stock 3.3.5 login screen, its only non-stock element: a
	"Server" field, the row under Password in the stock boxes' style, holding the address the
	login dials (host or host:port; the port defaults to 3724, and the
	tooltip says so). Stock 3.3.5 has no such control; its realmlist is realmlist.wtf.
	Leaving the field after an edit keeps it in $WRATHPLUS_HOME/realmlist.wtf, searched before the
	install's; an address the client cannot use is refused with a dialog and the field reverts.
	A launch with the server flag (or WOW_HOST) only sets the address the field starts at; the
	field stays editable, and an edit points this session (and the next launch without the flag) at it.
-->
<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Script>
		-- The field's tooltip: a colon and a port are allowed, for servers off the default port.
		WRATHPLUS_SERVER_FIELD_HINT = "Logon server: host or host:port\n(the port defaults to 3724)";

		-- The current address into the field.
		function WrathPlusServerField_Refresh(self)
			local address = WrathPlusGetRealmlist();
			self:SetText(address or "");
			self.committed = address;
		end
		-- Leaving the field commits an edit; the host answers with WRATHPLUS_REALMLIST_CHANGED.
		function WrathPlusServerField_Commit(self)
			local text = self:GetText();
			if ( text ~= self.committed ) then
				WrathPlusSetRealmlist(text);
			end
		end
	</Script>
	<EditBox name="AccountLoginServerEdit" parent="AccountLoginUI" letters="64" autoFocus="false">
		<Size x="200" y="37"/>
		<!-- The stock column's next row: the account-to-password gap (33) below the password box,
		     which stock re-anchors on every show (AccountLogin_SetupAccountListDDL). -->
		<Anchors>
			<Anchor point="TOP" relativeTo="AccountLoginPasswordEdit" relativePoint="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="-33"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- AccountLoginAccountEdit's label, as stock draws it. -->
				<FontString name="$parentLabel" inherits="GlueFontNormal" justifyH="CENTER" text="Server">
					<Size>
						<AbsDimension x="600" y="64"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOM" relativePoint="TOP">
							<Offset>
								<AbsDimension x="0" y="-23"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="10" right="5" top="4" bottom="9"/>
			</BackgroundInsets>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
		</Backdrop>
		<Scripts>
			<OnLoad>
				-- Stock colours its boxes' backdrops in AccountLogin_OnLoad, not in the XML.
				local backdropColor = DEFAULT_TOOLTIP_COLOR;
				self:SetBackdropBorderColor(backdropColor[1], backdropColor[2], backdropColor[3]);
				self:SetBackdropColor(backdropColor[4], backdropColor[5], backdropColor[6]);
				self:RegisterEvent("WRATHPLUS_REALMLIST_CHANGED");
			</OnLoad>
			<OnEnter>
				GlueTooltip_SetOwner(self);
				GlueTooltip_SetText(WRATHPLUS_SERVER_FIELD_HINT, nil, 1.0, 1.0, 1.0);
			</OnEnter>
			<OnLeave>
				GlueTooltip:Hide();
			</OnLeave>
			<OnShow>
				WrathPlusServerField_Refresh(self);
			</OnShow>
			<OnEvent>
				WrathPlusServerField_Refresh(self);
			</OnEvent>
			<OnEnterPressed>
				self:ClearFocus();
			</OnEnterPressed>
			<OnTabPressed>
				AccountLogin_FocusAccountName();
			</OnTabPressed>
			<OnEscapePressed>
				WrathPlusServerField_Refresh(self);
				self:ClearFocus();
			</OnEscapePressed>
			<OnEditFocusGained>
				self:HighlightText();
			</OnEditFocusGained>
			<OnEditFocusLost>
				self:HighlightText(0, 0);
				WrathPlusServerField_Commit(self);
			</OnEditFocusLost>
		</Scripts>
		<FontString inherits="GlueEditBoxFont"/>
		<TextInsets>
			<AbsInset left="12" right="5" bottom="5"/>
		</TextInsets>
	</EditBox>
	<!-- The stock Login button under the Server row, after stock places it on each show
	     (AccountLogin_SetupAccountListDDL sets it 60 below the password box). 20 below the field,
	     not stock's 60: the Remember Account Name checkbox hangs off the button's bottom and would
	     otherwise sit on the Blizzard logo at the foot of the screen. -->
	<Script>
		local stockSetup = AccountLogin_SetupAccountListDDL;
		function AccountLogin_SetupAccountListDDL(...)
			stockSetup(...);
			AccountLoginLoginButton:ClearAllPoints();
			AccountLoginLoginButton:SetPoint("TOP", AccountLoginServerEdit, "BOTTOM", 0, -20);
		end
	</Script>
</Ui>
